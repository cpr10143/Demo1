Si no estás en dev:

git switch dev
# git switch dev = cambia a la rama llamada 'dev'
# (es el comando moderno para cambiar de rama; más claro que 'checkout')

code hola.py

git status
# git status = muestra qué archivos han cambiado y si están 'tracked' o no

git diff
# git diff = muestra la diferencia línea a línea entre lo que hay en disco
